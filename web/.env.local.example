# Optional: for Next.js RSC fetches to the local API
INTERNAL_API_URL=http://127.0.0.1:4000
TMDB_API_KEY=your_key_here


# Copy to .env
# SQLite file is set at runtime in ~/.moviemanager/movies.db
DATABASE_URL="file:./placeholder.db"

# Required for TMDb enrichment
TMDB_API_KEY=

# API bind
API_HOST=127.0.0.1
API_PORT=4000
