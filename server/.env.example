# Copy to .env — do NOT set DATABASE_URL unless you want a custom SQLite path.
# Default at runtime: %USERPROFILE%\.moviemanager\movies.db  (run: npm run db:push from repo root)
#
# DATABASE_URL=file:C:/path/to/custom.db

# Required for TMDb enrichment
TMDB_API_KEY=

# API bind
API_HOST=127.0.0.1
API_PORT=4000

# Optional: Persian summaries when TMDb has no fa-IR overview (requires `ollama serve` and a pulled model)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# Optional (slow): during scan, ask Ollama to refine messy movie filenames to JSON title/year (default off)
# OLLAMA_TITLE_PARSE=1
