generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model LibraryPath {
  id        String   @id @default(cuid())
  path      String   @unique
  createdAt DateTime @default(now())
}

model Category {
  id     String          @id @default(cuid())
  name   String
  movies MovieCategory[]

  @@unique([name])
}

model MovieCategory {
  movieId    String
  categoryId String
  movie      Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([movieId, categoryId])
}

/// TV show container; episodes are Movie rows with mediaKind = episode.
model TvSeries {
  id              String   @id @default(cuid())
  /// Canonical match key: normalized title only (year omitted), so split folders merge under one series.
  normalizedKey   String   @unique
  title           String
  year            String?

  tmdbTvId        Int?
  imdbScore       String?
  imdbRating      String?
  summary         String?
  fullSummary     String?
  actors          String?
  directors       String?
  genre           String?
  imagePath       String?
  duration        String?
  numberOfVotes   String?

  /// Full TMDb JSON per HTTP response (search page, merged details+append_to_response, credits endpoint).
  tmdbSearchJson   Json?
  tmdbDetailsJson  Json?
  tmdbCreditsJson  Json?

  show            Boolean @default(true)
  isFavorite      Boolean @default(false)
  enrichmentState String  @default("none")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episodes Movie[]

  @@index([title])
}

/// Video file: standalone movie or one episode of a TvSeries.
model Movie {
  id     String @id @default(cuid())
  name   String
  year   String?

  filePath   String @unique
  folderPath String

  /// movie | episode
  mediaKind String @default("movie")

  seriesId String?
  series   TvSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  seasonNumber  Int?
  episodeNumber Int?
  episodeTitle  String?

  /// True when path/filename suggests a dubbed release (heuristic).
  dubbed          Boolean @default(false)

  imdbScore   String?
  imdbRating  String?
  summary     String?
  fullSummary String?
  actors      String?
  directors   String?
  genre       String?
  imagePath   String?
  duration    String?
  numberOfVotes String?

  /// Full TMDb JSON per HTTP response (search page, merged details+append_to_response, credits endpoint).
  tmdbSearchJson   Json?
  tmdbDetailsJson  Json?
  tmdbCreditsJson  Json?

  tmdbId   Int?
  show     Boolean @default(true)
  isFavorite Boolean @default(false)
  /// none | partial | full
  enrichmentState String @default("none")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories MovieCategory[]

  @@index([name])
  @@index([year])
  @@index([show])
  @@index([isFavorite])
  @@index([seriesId])
  @@index([mediaKind])
}
